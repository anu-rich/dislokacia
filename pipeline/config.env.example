# Рабочая почта (Exchange, mail.kmg.kz). Файл не попадает в git.
EWS_SERVER=mail.kmg.kz
# Полный адрес EWS, если он живёт не на EWS_SERVER (снаружи mail.kmg.kz отдаёт 404, а этот хост отвечает):
EWS_URL=https://autodiscover.kmtf.kmg.kz/EWS/Exchange.asmx
EWS_EMAIL=a.ichshanov@kmtf.kmg.kz
# Логин для NTLM: обычно как в OWA — a.ichshanov@kmtf.kmg.kz, либо ДОМЕН\a.ichshanov
EWS_USER=a.ichshanov@kmtf.kmg.kz
EWS_PASS=ВПИШИ_ПАРОЛЬ
# Сколько дней назад смотреть письма при первом запуске
FETCH_DAYS=3
# Если сервер с самоподписанным сертификатом — поставь 1
EWS_NO_VERIFY=0
