# Settings of the Stalia reading server. Copy this file to ".env" and fill in the first line.

# The key of your Anthropic account: https://console.anthropic.com -> API keys. Keep it secret.
ANTHROPIC_API_KEY=

# The address of your site, without a slash at the end. Several addresses are separated by commas.
# Empty = any site may call the server (the daily limits below still apply).
ALLOWED_ORIGINS=

# Which Claude model reads the documents: for readings with a Pro licence, and for free readings.
# claude-sonnet-5-5 is the careful one; claude-haiku-5-5 costs about twenty times less.
# Put the same name on both lines to use one model for everybody.
STALIA_MODEL=claude-sonnet-5-5
STALIA_MODEL_FREE=claude-haiku-5-5
# How thoroughly the model works: low | medium | high | xhigh | max.
STALIA_EFFORT=high

# Readings a day for one visitor without a licence. FREE_PER_DAY=0 makes reading a Pro-only feature.
FREE_PER_DAY=2
# Readings a calendar month for one Pro licence.
PRO_PER_MONTH=200
# There are no other limits here: your ceiling on spending is the monthly spend limit in the Anthropic console.

# Largest request: pages per reading and megabytes.
MAX_PAGES=20
MAX_BODY_MB=24

# Set to 1 when the server runs behind a proxy that adds X-Forwarded-For (Render, Railway, nginx).
TRUST_PROXY=0

# Lemon Squeezy shop, if Pro is sold through it (the same numbers as in app/config.js).
LS_STORE_ID=
LS_PRODUCT_IDS=

# Port to listen on (hosts such as Render set this themselves).
# PORT=8787
