{
  "name": "stalia-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Stalia — the small server that reads charter parties and statements of facts with Claude",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node node-server.js",
    "build:worker": "esbuild worker.js --bundle --format=esm --platform=browser --conditions=worker,browser --target=es2022 --minify --legal-comments=none --outfile=dist/stalia-worker.js",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
